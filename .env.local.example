# ============================================================================
# G-CrowdBang / F-CrowdBang · 本地环境变量模板
# 复制本文件为 `.env.local` 并填入真实值。`.env.local` 禁止提交进 Git。
# 红线：真实密钥永不入库、永不写入前端、永不写入日志。
# ============================================================================

# --- Firebase Admin (F-CrowdBang 服务端访问) ---
# 来源：Firebase 控制台 → 项目设置 → 服务账号 → 生成新的私钥
# 注意：private key 是多行字符串，写入 .env.local 时保留 \n 转义
#       （代码中已用 .replace(/\\n/g, "\n") 还原）。
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# --- 社交平台官方公开 API（结算接口 verify-and-payout 使用）---
# 按实际对接平台的官方 API 填写；仅服务端读取，绝不暴露给浏览器。
SOCIAL_PLATFORM_API_TOKEN=

# ============================================================================
# 安全要求
# 1. .env.local 与 .gitignore 中需含 .env*.local（本仓库 .gitignore 已含）。
# 2. FIREBASE_PRIVATE_KEY / SOCIAL_PLATFORM_API_TOKEN 为高敏凭据，
#    仅可在服务端组件 / Route Handler 中读取，禁止 import 到客户端组件。
# 3. 轮换密钥时同步更新 Firebase 服务账号与平台 API 凭据。
# ============================================================================
