# ============================================================================
# 📦 G-CrowdBang 官方环境配置文件安全模板（.env.local.example）
# 🚨 警告红线：请复制本文件并重命名为 .env.local，在本地填入真实凭证。
# 🚨 严禁将带有真实 Key 的 .env.local 提交到 GitHub 仓库中，防止金库外泄！
# ============================================================================

# ----------------------------------------------------------------------------
# 1. 前端可公开配置项（FCCshop / Firebase 公共连接句柄）
# 带 NEXT_PUBLIC_ 前缀会被打包进浏览器，仅允许放"公开可读"的配置。
# ----------------------------------------------------------------------------
NEXT_PUBLIC_FIREBASE_API_KEY=your_f_crowdbang_public_api_key
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your_f_crowdbang.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=f-crowdbang

# ----------------------------------------------------------------------------
# 2. Firebase Admin 服务端访问（F-CrowdBang）
# 来源：Firebase 控制台 → 项目设置 → 服务账号 → 生成新的私钥
# 注意：private key 为多行字符串，写入时保留 \n 转义（代码已用
#       .replace(/\\n/g, "\n") 还原）。
# 仅服务端读取，严禁带 NEXT_PUBLIC_ 前缀，严禁暴露给浏览器。
# ----------------------------------------------------------------------------
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ----------------------------------------------------------------------------
# 3. 🔺 后端服务器绝对保密配置（禁止带 NEXT_PUBLIC_ 前缀）
# 用于服务端中转 PayPal 招商收月租的 Live 账户密钥（仅服务端，勿前端读取）
# ----------------------------------------------------------------------------
PAYPAL_PRODUCTION_CLIENT_ID=your_paypal_live_client_id_never_expose_to_client
PAYPAL_PRODUCTION_SECRET=your_paypal_live_secret_key_never_expose_to_client

# ----------------------------------------------------------------------------
# 4. 社交平台开放平台合规开放接口凭证（结算接口标准公开状态异步反查）
# ----------------------------------------------------------------------------
SOCIAL_PLATFORM_APP_ID=your_official_compliant_developer_app_id
SOCIAL_PLATFORM_API_TOKEN=your_official_compliant_server_to_server_oauth_token

# ----------------------------------------------------------------------------
# 5. TikTok 官方开发者 OAuth 凭证（令牌签发/刷新与对账账本）
# 来源：TikTok for Developers 控制台 → 创建应用 → 获取 Client Key / Client Secret
# 注意：access_token/refresh_token 由标准 OAuth 回调动态签发，不入 .env；
#       此处仅存应用级 Client Key/Secret 与回调地址（仅服务端）。
# ----------------------------------------------------------------------------
TIKTOK_CLIENT_KEY=your_tiktok_official_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_official_client_secret_never_expose_to_client
TIKTOK_OAUTH_REDIRECT_URI=your_tiktok_oauth_redirect_uri

# ============================================================================
# 安全要求
# 1. .env.local 与 .gitignore 中需含 .env*.local（本仓库 .gitignore 已含）。
# 2. 带 NEXT_PUBLIC_ 前缀的项可进前端；其余均为高敏服务端凭据，禁止 import
#    到客户端组件、禁止写入日志。
# 3. 轮换密钥时同步更新 Firebase 服务账号 / PayPal / 平台 API 凭据。
# ============================================================================
