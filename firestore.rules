// F-CrowdBang · Firestore Security Rules
// 多租户隔离账本：商户仅能读写自己的 campaigns；接单状态与资金终态仅服务端(admin)可改；
// users 余额仅本人可读；platform_accounts（官方利润账户）仅服务端 admin 可写。
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isMerchant() { return isSignedIn() && request.auth.token.role == 'merchant'; }
    function isWorker()  { return isSignedIn() && request.auth.token.role == 'worker'; }
    function isAdmin()   { return isSignedIn() && request.auth.token.role == 'admin'; }
    function isOwner(uid) { return request.auth.uid == uid; }

    // ---------- 集合一：campaigns（商户悬赏任务总表）----------
    match /campaigns/{campaignId} {
      // 公开只读：任务大厅需要浏览可接任务
      allow read: if isSignedIn();

      // 创建：仅商户，且 owner 必须是本人（租户归属硬约束）
      allow create: if isMerchant()
        && request.resource.data.owner_merchant_id == request.auth.uid;

      // 更新：仅该任务所属商户本人；禁止篡改归属与托管资金
      allow update: if isMerchant()
        && isOwner(resource.data.owner_merchant_id)
        && request.resource.data.owner_merchant_id == resource.data.owner_merchant_id;

      // 删除：严禁删除，防止资金对账产生逻辑死结
      allow delete: if false;
    }

    // ---------- 集合二：submissions（接单与设备对账总表）----------
    match /submissions/{submissionId} {
      // 创建：仅接单用户，worker 必须是本人；初始态必须为 PENDING_AUDIT + held
      allow create: if isWorker()
        && request.resource.data.worker_id == request.auth.uid
        && request.resource.data.audit_metadata.verification_status == 'PENDING_AUDIT'
        && request.resource.data.payout_status == 'held';

      // 读取：本人接单 或 任务所属商户 或 管理员
      allow read: if (isWorker() && isOwner(resource.data.worker_id))
        || isAdmin()
        || (isMerchant()
            && get(/databases/$(database)/documents/campaigns/$(resource.data.campaign_id)).data.owner_merchant_id == request.auth.uid);

      // 更新：PENDING_AUDIT 阶段本人可改可编辑字段；核验/资金终态仅服务端(admin)
      // 同时强制：核验状态与资金状态只能由 admin 变更（worker 不可自改终态）
      allow update: if (isWorker() && isOwner(resource.data.worker_id)
                        && resource.data.audit_metadata.verification_status == 'PENDING_AUDIT'
                        && request.resource.data.audit_metadata.verification_status == resource.data.audit_metadata.verification_status
                        && request.resource.data.payout_status == resource.data.payout_status)
        || isAdmin();

      // 删除：仅管理员
      allow delete: if isAdmin();
    }

    // ---------- 集合三：users（接单人余额与资料）----------
    match /users/{userId} {
      // 读取：仅本人（余额为隐私，不公开）
      allow read: if isOwner(userId) || isAdmin();

      // 创建：仅本人，角色由认证层下发，默认 worker
      allow create: if isOwner(userId)
        && request.resource.data.role == 'worker'
        && request.resource.data.balance_usd == 0;

      // 更新：本人可改非资金资料；余额(balance_usd)仅 admin（结算进程）可改
      allow update: if isAdmin()
        || (isOwner(userId)
            && request.resource.data.balance_usd == resource.data.balance_usd);

      // 删除：仅管理员
      allow delete: if isAdmin();
    }

    // ---------- 集合四：platform_accounts（官方利润账户）----------
    // 官方利润账户只进不出：仅服务端 admin 可写；对普通用户完全隐藏
    match /platform_accounts/{accountId} {
      allow read: if isAdmin();
      allow write: if isAdmin();
    }
  }
}
